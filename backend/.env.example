# Copy to backend/.env and adjust. Every value has a working default except
# SECRET_KEY, which you must change before deploying.

# SQLite needs no server and is fine for local development.
# MySQL: mysql+pymysql://user:password@localhost:3306/proeduvate
DATABASE_URL=sqlite:///./app.db

# Signs access and password-reset tokens. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call this API. The Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where uploaded certificates and documents are stored.
UPLOAD_DIR=uploads

# Set true to log every SQL statement.
SQL_ECHO=false

# Shared code required to sign a record off as verified (see /interns/{id}/verify)
VERIFICATION_CODE=proeduvate-verify-2026
