# Copy to backend/.env and adjust. Every value has a working default except
# SECRET_KEY, which you must change before deploying.

# PostgreSQL. Create the database once with:  createdb proeduvate_portal
# Then apply the schema with:                  alembic upgrade head
DATABASE_URL=postgresql+psycopg://YOUR_PG_USER@localhost:5432/proeduvate_portal

# Signs access and password-reset tokens. Use a long random string.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call this API. Supports comma-separated list, space-separated, or JSON array.
# Examples:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex pattern for allowed origins
# CORS_ORIGIN_REGEX=https://.*\.yourdomain\.com

# Where uploaded certificates and documents are stored.
UPLOAD_DIR=uploads

# Set true to log every SQL statement.
SQL_ECHO=false

# Shared code required to sign a record off as verified (see /interns/{id}/verify)
VERIFICATION_CODE=proeduvate-verify-2026
